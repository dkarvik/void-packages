#!/bin/sh
# gitolite post-receive trigger for void-packages: enqueue a build via nq.
#
# Executed by the gitolite GLOBAL dispatcher (hooks/gitolite-post-receive)
# for every push to this repo.  Enqueues the nightly builder into the
# xbps-builder user's nq queue, which runs jobs one at a time (no daemon).
# The push returns immediately; the build's output goes to syslog via
# logger inside the queued job (xbps-nightly/nq-job.sh).
#
# Loop guard: the builder force-pushes the rebuilt branch back; that push
# must not re-enqueue, so skip when the pushed newrev == last recorded
# built HEAD.
#
# Sudoers rule (single exact command):
#   gitolite ALL=(xbps-builder) NOPASSWD: \
#     /var/lib/xbps-builder/void-packages/xbps-nightly/nq-enqueue.sh

set -u

REF="refs/heads/personal"
BUILDER=xbps-builder
BUILDER_HOME=/var/lib/xbps-builder
ENQUEUE=/var/lib/xbps-builder/void-packages/xbps-nightly/nq-enqueue.sh

[ "${GIT_REF:-}" = "$REF" ] || exit 0

# skip the builder's own push-back of a built HEAD
[ -f "$BUILDER_HOME/state/last-head" ] && \
	[ "$(cat "$BUILDER_HOME/state/last-head" 2>/dev/null)" = "${GIT_NEWREV:-}" ] && {
	echo "xbps-nightly: push back of built HEAD, skipping rebuild"
	exit 0
}

# enqueue the build; nq returns immediately and runs jobs serially.
sudo -n -u "$BUILDER" "$ENQUEUE" >/dev/null 2>&1
rc=$?
[ "$rc" -eq 0 ] || echo "xbps-nightly: nq enqueue failed rc=$rc"
exit 0