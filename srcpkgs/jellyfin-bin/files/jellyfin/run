#!/bin/sh

exec 2>&1

JELLYFIN_DATA_DIR="/var/lib/jellyfin"
JELLYFIN_CONFIG_DIR="/etc/jellyfin"
JELLYFIN_LOG_DIR="/var/log/jellyfin"
JELLYFIN_CACHE_DIR="/var/cache/jellyfin"

[ -r ./conf ] && . ./conf

: ${USER:=_jellyfin}
: ${GROUP:=_jellyfin}

exec chpst -u ${USER}:${GROUP} jellyfin --datadir=${JELLYFIN_DATA_DIR} --configdir=${JELLYFIN_CONFIG_DIR} --logdir=${JELLYFIN_LOG_DIR} --cachedir=${JELLYFIN_CACHE_DIR} ${JELLYFIN_ADD_OPTS}
