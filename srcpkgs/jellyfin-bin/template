do_install() {
  vmkdir usr/lib/jellyfin
  vcopy . usr/lib/jellyfin

  mkdir -p $DESTDIR/usr/bin/
  ln -s /usr/lib/jellyfin/jellyfin $DESTDIR/usr/bin/jellyfin

  vsv jellyfin
}
