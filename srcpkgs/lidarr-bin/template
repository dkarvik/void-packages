# Template file for 'lidarr-bin'
pkgname=lidarr-bin
version=3.1.0.4875
create_wrksrc=yes
revision=1
short_desc="Lidarr is a music collection manager for Usenet and BitTorrent users"
maintainer="Dominic Monroe <dominic@dominic.io>"
license="GPL-3.0-or-later"
homepage="https://lidarr.audio/"
distfiles="https://github.com/Lidarr/Lidarr/releases/download/v${version}/Lidarr.master.${version}.linux-core-x64.tar.gz"
system_accounts="_lidarr"
make_dirs="/var/lib/lidarr 0750 _lidarr _lidarr"
checksum=20f175aec2b908de2ae06b72544dae504efddb5db2a97ea4e36866de53bc2fa5

do_install() {
	mkdir -p $DESTDIR/opt/Lidarr
	# ls -lasd *
	cp -r * $DESTDIR/opt/Lidarr/

	# Add symlink for lidarr
	mkdir -p $DESTDIR/usr/bin/
	ln -s /opt/Lidarr/Lidarr $DESTDIR/usr/bin/Lidarr

	vsv lidarr
}
