do_build() {
	. /etc/profile.d/jdk.sh
	mvn -q -pl core -am package -DskipTests
}

do_install() {
	vmkdir /usr/lib/nzbhydra2
	vcopy core/target/core-*-exec.jar /usr/lib/nzbhydra2/core-exec.jar
	vsv nzbhydra2
	# vbin core/target/core
}
