# Template file for 'olivetin'
pkgname=olivetin
version=3000.20.0
revision=1
nopie=yes
wrksrc="OliveTin-${version}"
hostmakedepends="go nodejs python3"

short_desc="Web interface for running predefined shell commands"
maintainer="Orphaned <orphan@voidlinux.org>"
license="AGPL-3.0-only"
homepage="https://www.olivetin.app/"
distfiles="https://github.com/OliveTin/OliveTin/archive/refs/tags/${version}.tar.gz"
checksum=fa0cd2ef577756e701aeb0ce4ee3918019e5c78ce4ecee568d51e31a65f4474a
system_accounts="_olivetin"
make_dirs="/etc/OliveTin 0750 _olivetin _olivetin
 /var/lib/olivetin 0750 _olivetin _olivetin"

do_build() {
	make -C frontend dist
	sed -i 's|config.WebUIDir = "./webui"|config.WebUIDir = "/usr/share/olivetin/webui"|' service/internal/config/config.go
	(cd service && go build -buildmode=pie -ldflags "-X main.version=${version}" -o OliveTin .)
}

do_install() {
	vbin service/OliveTin
	vmkdir usr/share/olivetin/webui
	vcopy frontend/dist/. usr/share/olivetin/webui
	vsv olivetin
}

