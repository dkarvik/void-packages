#!/bin/sh
# xbps-nightly - nightly builder for the "personal" void-packages branch.
#
# Lives in <checkout>/xbps-nightly/ inside the same git repository it builds
# from.  Pipeline:
#   fetch upstream -> rebase personal onto origin/master -> bootstrap
#   -> run generators (xbps-nightly/gen/*) -> build selected packages
#   -> sign branch repository
#
# Exit: 0 ok, 1 some package failed, 2 git/repo problem, 3 usage.

set -u

# Tool dir is the directory owning this script; the checkout is its parent.
cd "$(dirname "$0")" || exit 3
TOOLDIR="$PWD"
VPDIR="$(dirname "$TOOLDIR")"

log() { echo "==> $*"; }
die() { echo "error: $*" >&2; exit 2; }

case "$(basename "$TOOLDIR")" in
	xbps-nightly) ;;
	*) die "expected tool dir to be <checkout>/xbps-nightly, got '$TOOLDIR'" ;;
esac

# ---- optional settings (xbps-nightly.conf, sourced) ----
#   PUSH_REMOTE=fortmonroe        push the rebuilt `personal` branch back
#   PUSH_BRANCH=personal          branch to push (default: current)
#   UPSTREAM_REMOTE=upstream      remote with Void's `master` to rebase onto
#                                 (e.g. github.com/void-linux/void-packages).
#                                 When set, origin is treated as the canonical
#                                 `personal` home (gitolite) and the working
#                                 branch is reset to origin/PUSH_BRANCH before
#                                 rebasing.  Unset = original behaviour
#                                 (fetch origin, rebase origin/master).
CONF="$VPDIR/../xbps-nightly.conf"
[ -f "$CONF" ] && . "$CONF"
# legacy/optional: conf inside the tool dir (untracked or committed)
CONF2="$TOOLDIR/xbps-nightly.conf"
[ -f "$CONF2" ] && . "$CONF2"
PUSH_REMOTE="${PUSH_REMOTE:-}"
PUSH_BRANCH="${PUSH_BRANCH:-personal}"
UPSTREAM_REMOTE="${UPSTREAM_REMOTE:-}"

# ---- signing keys (keep outside the checkout at $TOOLDIR/../id_rsa) ----
if [ ! -f "$VPDIR/../id_rsa" ]; then
	log "generating repository signing key"
	rm -f "$VPDIR/../id_rsa" "$VPDIR/../id_rsa.pub"
	ssh-keygen -b 4096 -t rsa -m PEM -N "" -f "$VPDIR/../id_rsa"
fi

# ---- checkout ----
if [ ! -d "$VPDIR/srcpkgs" ]; then
	die "no checkout at $VPDIR; clone void-packages here and run this from a checkout on branch 'personal'"
fi

cd "$VPDIR" || die "cannot enter $VPDIR"

# A crashed/stopped rebase from a previous run leaves us detached mid-rebase;
# recover deterministically instead of building from a broken tree.
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then
	log "stale rebase in progress; aborting"
	git rebase --abort >/dev/null 2>&1 || git am --abort >/dev/null 2>&1 || true
fi

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo unknown)"
[ "$branch" = "personal" ] || die "expected branch 'personal', on '$branch'"

# The builder commits (generator output) - needs a stable git identity.
if ! git config user.email >/dev/null 2>&1; then
	git config user.email "xbps-builder@deoch"
	git config user.name "xbps-builder"
fi

log "fetching upstream void-packages"
if [ -n "$UPSTREAM_REMOTE" ]; then
	git fetch origin || die "git fetch (origin) failed"
	git fetch "$UPSTREAM_REMOTE" || die "git fetch ($UPSTREAM_REMOTE) failed"
else
	git fetch origin || die "git fetch failed"
fi

# ---- our own generated config must not count as dirty state ----
log "cleaning builder-generated config"
for f in etc/repos-remote.conf etc/repos-remote-x86_64.conf etc/conf; do
	rm -f "$f"
done
git checkout -- etc/repos-remote.conf 2>/dev/null || true

if [ -n "$(git status --porcelain)" ]; then
	log "checkout is not clean; refusing to rebase:"
	git status --short
	die "please commit or stash local changes in $VPDIR"
fi

if [ -n "$UPSTREAM_REMOTE" ]; then
	# origin is the canonical `personal` home (gitolite): adopt the pushed
	# tip, then move onto Void's upstream master.
	log "adopting origin/$PUSH_BRANCH"
	git reset --hard "origin/$PUSH_BRANCH" || die "reset to origin/$PUSH_BRANCH failed"
	log "rebasing $PUSH_BRANCH onto $UPSTREAM_REMOTE/master"
	# our branch is additive (custom packages); on conflict prefer ours
	if ! git rebase --strategy-option=ours "$UPSTREAM_REMOTE/master"; then
		log "rebase failed; resolve conflicts manually, then re-run xbps-nightly"
		exit 2
	fi
else
	log "rebasing personal onto origin/master"
	if ! git rebase origin/master; then
		log "rebase failed; resolve conflicts manually, then re-run xbps-nightly"
		exit 2
	fi
fi

# ---- mirror/repository config overrides (mirrors xbps-mini-builder) ----
if [ -d /etc/xbps.d ]; then
	cat /etc/xbps.d/* > etc/repos-remote.conf
	if [ "$(xbps-uhelper arch)" = "x86_64" ]; then
		cat /etc/xbps.d/* > etc/repos-remote-x86_64.conf
	fi
	if [ -f /etc/xbps.d/00-repository-main.conf ]; then
		repo="$(sed 's/^.*=//' < /etc/xbps.d/00-repository-main.conf)"
		# binary-bootstrap needs the bootstrap repo for base-chroot, which is
		# not in the host's 00-repository-main.conf.  Use --repository= (the
		# -r flag of xbps-install means rootdir, not repository).
		printf 'XBPS_INSTALL_ARGS="--repository=%s --repository=%s/bootstrap --repository=%s/musl"\n' \
			"$repo" "$repo" "$repo" > etc/conf
	fi
fi

if [ -f "$TOOLDIR/xbps-src.conf" ]; then
	cat "$TOOLDIR/xbps-src.conf" >> etc/conf
fi

# ---- bootstrap ----
# masterdir naming varies by xbps-src version (masterdir vs masterdir-<arch>)
if [ -d masterdir ] || [ -d "masterdir-$(xbps-uhelper arch)" ]; then
	log "bootstrap-update"
	./xbps-src bootstrap-update || die "bootstrap-update failed"
else
	log "binary-bootstrap (first run)"
	./xbps-src binary-bootstrap || die "binary-bootstrap failed"
fi

# ---- generators ----
genfail=0
for gen in "$TOOLDIR"/gen/*; do
	[ -x "$gen" ] || continue
	log "running generator $gen"
	if ! "$gen"; then
		log "generator $gen failed"
		genfail=1
	fi
done
[ "$genfail" -eq 0 ] || die "one or more generators failed"

# ---- build ----
manual=0
if [ "$#" -gt 0 ]; then
	manual=1
else
	set -- $(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$TOOLDIR/packages.list")
fi

[ "$#" -gt 0 ] || die "no packages selected and packages.list is empty"

# Only rebuild packages whose srcpkgs/ dir changed since the last successful
# run, or that have no build in the branch repository.  xbps-src pkg overwrites
# on every invocation, so unconditional building would redo e.g. maven builds
# nightly.  Explicit arguments (manual run) always build.
# Generated packages (neovim-git) commit their own changes; custom packages get
# manual commits.  Both show up in `git diff` of their srcpkgs/ dir, so a plain
# diff against the last successfully built HEAD is the change signal.
STATE="${XBPN_STATE:-$VPDIR/../state}"
mkdir -p "$STATE"
last_head=""
[ -f "$STATE/last-head" ] && last_head=$(cat "$STATE/last-head")

buildfail=0
if [ "$manual" -eq 1 ]; then
	for pkg in "$@"; do
		log "building $pkg"
		if ! ./xbps-src pkg "$pkg"; then
			log "build of $pkg FAILED; keeping last good build for it"
			buildfail=1
		fi
	done
else
	changed=""
	for pkg in "$@"; do
		needs=1
		if [ -n "$last_head" ]; then
			if git diff --quiet "$last_head" HEAD -- "srcpkgs/$pkg" 2>/dev/null; then
				needs=0
				if [ -z "$(ls "$VPDIR/hostdir/binpkgs/personal/${pkg}-"*.x86_64.xbps 2>/dev/null)" ]; then
					needs=1   # no build present, rebuild regardless
				fi
			fi
		fi
		if [ "$needs" -eq 1 ]; then
			changed="$changed $pkg"
		else
			log "skipping $pkg (unchanged since $last_head)"
		fi
	done
	for pkg in $changed; do
		log "building $pkg"
		if ! ./xbps-src pkg "$pkg"; then
			log "build of $pkg FAILED; keeping last good build for it"
			buildfail=1
		fi
	done
	if [ "$buildfail" -eq 0 ]; then
		git rev-parse HEAD > "$STATE/last-head"
	fi
fi

# ---- sign the branch repository ----
BINPKGS="$VPDIR/hostdir/binpkgs/personal"
if [ -d "$BINPKGS" ]; then
	log "signing repository $BINPKGS"
	xbps-rindex --sign --signedby "xbps-nightly" --privkey "$VPDIR/../id_rsa" "$BINPKGS"
	for f in "$BINPKGS"/*.xbps; do
		[ -e "$f" ] || continue
		xbps-rindex --sign-pkg --privkey "$VPDIR/../id_rsa" "$f"
	done
	find "$BINPKGS" -maxdepth 1 -type d -mindepth 1 | while read -r sub; do
		log "signing subrepository $sub"
		xbps-rindex --sign --signedby "xbps-nightly" --privkey "$VPDIR/../id_rsa" "$sub"
		for f in "$sub"/*.xbps; do [ -e "$f" ] || continue; xbps-rindex --sign-pkg --privkey "$VPDIR/../id_rsa" "$f"; done
	done

	# Trust our own key so chroot builds never prompt to import it.
	mkdir -p etc/repo-keys
	pub="$VPDIR/../id_rsa.pub.pem"
	openssl rsa -in "$VPDIR/../id_rsa" -pubout > "$pub" 2>/dev/null
	fp=$(python3 -c '
import re, hashlib, struct, subprocess, sys
out = subprocess.run(["openssl","rsa","-in",sys.argv[1],"-text","-noout"],
    capture_output=True,text=True).stdout
mhex = "".join(re.findall(r"[0-9a-f]+", re.search(r"modulus:\n(.*?)\npublicExponent", out, re.S).group(1)))
m = int(mhex,16)
e = int(re.search(r"publicExponent: (\d+)", out).group(1))
nb = m.to_bytes((m.bit_length()+7)//8,"big")
eb = e.to_bytes((e.bit_length()+7)//8,"big")
def enc(b):
    if b[0] & 0x80: b = b"\x00"+b
    return struct.pack(">I",len(b))+b
blob = b"\x00\x00\x00\x07ssh-rsa" + enc(eb) + enc(nb)
h = hashlib.md5(blob).hexdigest()
print(":".join(h[i:i+2] for i in range(0,len(h),2)))
' "$VPDIR/../id_rsa")
	plist="etc/repo-keys/${fp}.plist"
	if [ ! -f "$plist" ]; then
		size=$(openssl rsa -in "$VPDIR/../id_rsa" -text -noout 2>/dev/null | sed -n 's/^Public-Key: (\([0-9]*\) bit)/\1/p')
		{
			printf '<?xml version="1.0" encoding="UTF-8"?>\n'
			printf '<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
			printf '<plist version="1.0">\n<dict>\n'
			printf '\t<key>public-key</key>\n\t<data>'
			base64 -w0 "$pub"
			printf '</data>\n'
			printf '\t<key>public-key-size</key>\n\t<integer>%s</integer>\n' "$size"
			printf '\t<key>signature-by</key>\n\t<string>xbps-nightly</string>\n'
			printf '</dict>\n</plist>\n'
		} > "$plist"
		log "wrote repo key plist for chroot trust: $plist"
	fi
else
	log "no branch repository found at $BINPKGS (nothing built?)"
fi

# ---- push the rebuilt branch back up (optional) ----
# After a successful run, `personal` was rebased onto origin/master and the
# generator may have committed package updates.  Push it back to a gitolite/
# mirror remote so the server copy stays the canonical one.  The rebase
# rewrote history, so force-push is required; guarded by --force-with-lease.
if [ "$buildfail" -eq 0 ] && [ -n "$PUSH_REMOTE" ]; then
	if git remote | grep -qx "$PUSH_REMOTE"; then
		# lease is only valid against a current tracking ref; fetch first
		git fetch "$PUSH_REMOTE" "$PUSH_BRANCH" >/dev/null 2>&1 || true
		# push a HEAD:branch with force-with-lease=<localref>:<expected tracking ref>
		if git push --force-with-lease="$PUSH_BRANCH:$PUSH_REMOTE/$PUSH_BRANCH" "$PUSH_REMOTE" "HEAD:$PUSH_BRANCH"; then
			log "pushed $PUSH_BRANCH -> $PUSH_REMOTE"
		else
			log "WARNING: push to $PUSH_REMOTE failed; run manually:"
			log "  git push --force-with-lease=$PUSH_BRANCH:$PUSH_REMOTE/$PUSH_BRANCH $PUSH_REMOTE HEAD:$PUSH_BRANCH"
			buildfail=1
		fi
	else
		log "WARNING: PUSH_REMOTE '$PUSH_REMOTE' is not a configured remote; skipping push"
	fi
fi

if [ "$buildfail" -ne 0 ]; then
	log "some packages failed to build; see logs above"
	exit 1
fi
log "done"
exit 0